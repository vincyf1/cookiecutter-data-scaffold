# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Data / lakehouse
*.duckdb
data/

# dbt
dbt_packages/
target/

# Airflow (the directory itself is tracked via .gitkeep so the compose bind
# mount lands on a host-owned dir rather than one docker creates as root)
logs/*
!logs/.gitkeep

# Holds AIRFLOW_UID, pinned to the uid of the machine this project was
# generated on. Committing it would hand the next machine a stale value that
# silently breaks the same mounts the variable exists to keep writable.
.env
{%- if cookiecutter.include_agentic %}

# Agentic healing output: a .patch, a metadata .json, and a trace per run
artifacts/*
!artifacts/.gitkeep

# Grader reports (regenerated per run; the .gitkeep is what's tracked)
evals/reports/*.json
evals/reports/*.md
{%- endif %}
